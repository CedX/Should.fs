<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>Cedric-Belin.fr</Company>
		<Copyright>© Cédric Belin</Copyright>
		<Description>A thin BDD wrapper around MSTest assertions, for F#.</Description>
		<Product>BDD assertions for MSTest</Product>
		<Version>2026.12.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>CedX</Authors>
		<IncludeSymbols>true</IncludeSymbols>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>ReadMe.md</PackageReadmeFile>
		<PackageTags>assertion;bdd;mstest;test;testing</PackageTags>
		<RepositoryUrl>https://github.com/CedX/Should.fs.git</RepositoryUrl>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AssemblyName>Belin.Should</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutDir>../Binaries</OutDir>
		<RootNamespace>Belin.Should</RootNamespace>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
		<None Include="../Icon.png" Pack="true" PackagePath="" />
		<None Include="../ReadMe.md" Pack="true" PackagePath="" />
		<PackageReference Update="FSharp.Core" Version="11.0.101" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Should.fs" />
		<Compile Include="Should.Async.fs" />
		<Compile Include="Should.Task.fs" />
	</ItemGroup>
</Project>
